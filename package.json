{
  "name": "eyi-food",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint src",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write --ignore-unknown src tests database .github README.md",
    "dev:turbo": "next dev --turbopack",
    "db:check": "node scripts/check-database.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "lucide-react": "^1.31.0",
    "next": "16.4.3",
    "next-auth": "^4.24.13",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10.13.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "@eslint/js": "^10.0.0",
    "typescript-eslint": "8.72.1",
    "eslint-plugin-react-hooks": "7.1.1"
  }
}
